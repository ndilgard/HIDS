{
  "dataDir": "/mnt/omv/HIDS",
  "gmailEnvPath": "/home/nate/Claude_Code/Projects/HAL/hal-skeleton/credentials/gmail-smtp.env",
  "web": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "fim": {
    "watchPaths": [
      "~/.ssh",
      "~/.bashrc",
      "~/.zshrc",
      "/etc/passwd",
      "/home/nate/Claude_Code/Projects/HAL/hal-skeleton/credentials"
    ],
    "reconcileIntervalMs": 900000,
    "debounceMs": 500,
    "watchTrustedProcessBinaries": true
  },
  "process": {
    "pollIntervalMs": 10000,
    "suspiciousDirs": ["/tmp", "/dev/shm", "/var/tmp"]
  },
  "auth": {
    "reconnectBackoffMs": 5000
  },
  "network": {
    "pollIntervalMs": 30000,
    "alertOnNewListener": true,
    "alertOnOutbound": true,
    "alertOnUdp": false
  },
  "alert": {
    "debounceMs": 45000,
    "emailOnNewBinary": false
  },
  "heartbeat": {
    "enabled": true,
    "url": "https://hc-ping.com/YOUR-CHECK-UUID-HERE",
    "intervalMs": 120000,
    "apiKey": "YOUR-READ-ONLY-API-KEY-HERE"
  }
}
